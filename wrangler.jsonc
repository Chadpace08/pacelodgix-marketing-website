{
  // THE MARKETING Worker -> pacelodgix.com (+ www)
  // Serves ONLY this marketing/ folder. Deploy from inside marketing/:
  //   cd marketing && npx wrangler deploy
  "name": "pacelodgix",
  "compatibility_date": "2026-07-17",
  // Only the custom domain is public; the *.workers.dev URL is disabled.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "."
  },
  "routes": [
    { "pattern": "pacelodgix.com", "custom_domain": true },
    { "pattern": "www.pacelodgix.com", "custom_domain": true }
  ]
}
